<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mailing_trace_resend_wizard_view_form" model="ir.ui.view">
        <field name="name">mailing.trace.resend.wizard.form</field>
        <field name="model">mailing.trace.resend.wizard</field>
        <field name="arch" type="xml">
            <form string="Resend Selected Traces">
                <field name="trace_ids" invisible="1"/>

                <div class="alert alert-info" role="alert">
                    The original traces will be kept. The resend creates new
                    traces linked to their source traces. Blacklist and opt-out
                    protections remain active.
                </div>

                <group>
                    <group>
                        <field name="selected_count" readonly="1"/>
                        <field name="recipient_count" readonly="1"/>
                        <field name="mailing_count" readonly="1"/>
                        <field name="draft_mailing_count"
                               readonly="1"
                               invisible="draft_mailing_count == 0"/>
                    </group>
                    <group>
                        <field name="successful_count" readonly="1"/>
                        <field name="duplicate_count" readonly="1"/>
                        <field name="skipped_count" readonly="1"/>
                    </group>
                </group>


                <div class="alert alert-warning"
                     role="alert"
                     invisible="draft_mailing_count == 0">
                    One or more source mailings are currently in draft. The
                    resend will use the current draft subject and content, not
                    a historical copy of the original message.
                </div>

                <div class="alert alert-warning"
                     role="alert"
                     invisible="successful_count == 0">
                    Some selected traces were already successfully delivered.
                    Confirming will intentionally attempt to send those
                    recipients another copy.
                </div>

                <div class="alert alert-warning"
                     role="alert"
                     invisible="not skip_reason_details">
                    <strong>Ignored selections:</strong>
                    <field name="skip_reason_details"
                           readonly="1"
                           nolabel="1"
                           class="oe_inline"/>
                </div>

                <div class="alert alert-warning"
                     role="alert"
                     invisible="duplicate_count == 0 and skipped_count == 0">
                    Duplicate trace selections are collapsed to one resend per
                    mailing and recipient. Ineligible selections are ignored.
                </div>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Resend"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
