<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.mass.mailing.disable.tracking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mass_mailing.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mass_mailing']" position="inside">
                <block title="Tracking" name="tracking_setting_container">
                    <setting name="track_open" string="Track openings">
                        <field name="mailing_track_open"/>
                        <div class="text-muted">
                            Add an invisible tracking image to mass mailing messages to track their opening by the recipient
                        </div>
                    </setting>

                    <setting name="track_links" string="Track links">
                        <field name="mailing_track_links"/>
                        <div class="text-muted">
                            Convert links in mass mailing messages to track link clicks by the recipient
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
