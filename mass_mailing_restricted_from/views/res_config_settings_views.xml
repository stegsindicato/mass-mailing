<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mailing_restricted_from" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.mailing.restricted.from</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mass_mailing.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mass_mailing']" position="inside">
                <block title="Restricted Senders" name="restricted_senders_setting_container">
                    <setting name="restricted_from_addresses_setting"
                             string="Restricted From addresses"
                             help="Una dirección o patrón por línea. Se aceptan wildcards como '*@steg.gal' o 'marketing+*@steg.gal'. Solo los usuarios del grupo 'Can send restricted mailings' podrán enviar campañas usando direcciones que coincidan con estos patrones.">
                        <field name="mailing_restricted_from_addresses"
                               placeholder="marketing@steg.gal&#10;comunicacion@steg.gal&#10;*@steg.gal&#10;marketing+*@steg.gal"
                               nolabel="1"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>